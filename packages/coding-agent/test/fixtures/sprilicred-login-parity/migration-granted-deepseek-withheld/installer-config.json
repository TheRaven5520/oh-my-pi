{
  "auth.broker.url": "https://sprilicred.example",
  "cycleModels": [
    "sprilicred-anthropic/claude-opus-5-5",
    "sprilicred-openai/*"
  ],
  "enabledModels": [
    "sprilicred-anthropic/*",
    "sprilicred-openai/*",
    "sprilicred-openrouter/**",
    "mine/*"
  ],
  "modelProviderOrder": [
    "sprilicred-openai",
    "sprilicred-openrouter",
    "personal-openai"
  ],
  "modelRoles": {
    "default": "sprilicred-openrouter/meta/muse-wonder:high",
    "smol": "sprilicred-anthropic/claude-haiku-4-5",
    "tiny": "sprilicred-anthropic/claude-haiku-4-5",
    "judge": "sprilicred-anthropic/claude-haiku-4-5",
    "slow": "sprilicred-openai/gpt-6.1-sol",
    "web": "sprilicred-anthropic/claude-haiku-4-5",
    "mine": "sprilicred-openrouter/meta/muse-wonder:high",
    "plan": "sprilicred-openai/gpt-6-astra:low"
  },
  "modelPresets": {
    "work": {
      "modelRoles": {
        "default": "sprilicred-openrouter/meta/muse-wonder:high",
        "slow": "sprilicred-openai/gpt-6.1-sol"
      },
      "defaultThinkingLevel": "high"
    },
    "muse-wonder": {
      "modelRoles": {
        "default": "sprilicred-openai/gpt-6-astra"
      }
    }
  },
  "retry.fallbackChains": {
    "sprilicred-openrouter/meta/muse-wonder": [
      "sprilicred-openai/gpt-6-astra"
    ]
  },
  "retry.usageLimitFallbackChains": {
    "sprilicred-openai/*": [
      "personal-openai/*"
    ]
  },
  "auth.broker.token": ""
}
